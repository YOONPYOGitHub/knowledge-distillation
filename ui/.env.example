API_HOST=127.0.0.1
API_PORT=8000
API_BASE_URL=http://127.0.0.1:8000
DEFAULT_RUN_ID=
MODEL_CACHE_SIZE=2
DEVICE=auto

# 저장소 추상화 — 기본 local 은 results/ 폴더 직접 사용
# blob 으로 전환하면 Azure Blob + 디스크 LRU 캐시 사용
STORAGE_BACKEND=local
# AZURE_STORAGE_ACCOUNT=<storageAccountName>
# AZURE_BLOB_CONTAINER=kd-results
# AZURE_CLIENT_ID=<UAMI client id>          # DefaultAzureCredential 힌트
# AZURE_BLOB_CACHE_DIR=/tmp/kd-cache
# AZURE_BLOB_CACHE_MAX_GB=4
